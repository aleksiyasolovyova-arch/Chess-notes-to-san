{
  "iso_code": "en",
  "grid_section": {
    "pieces": {
      "K": "King",
      "Q": "Queen",
      "R": "Rook",
      "B": "Bishop",
      "N": "Knight"
    },

    "valid_characters": {
      "letters": ["K", "Q", "R", "B", "N", "D", "T", "L", "P", "R",  "F", "C", "a", "b", "c", "d", "e", "f", "g", "h"],
      "numbers": ["1", "2", "3", "4", "5", "6", "7", "8"],
      "symbols": ["x", "+", "#", "=", "-", "O", "/"]
    },

   "cleaning_rules": [
     {
        "pattern": "\\b[oO0]-[oO0]-[oO0]\\b",
        "replacement": "O-O-O"
      },
      {
        "pattern": "\\b[oO0]-[oO0]\\b",
        "replacement": "O-O"
      },
      {
        "pattern": ":",
        "replacement": "x"
      },
      {
        "pattern": "(?<=[NBRQK])[Il](?=[a-h])",
        "replacement": "1"
      },
      {
        "pattern": "\\s+",
        "replacement": ""
      }
    ],

    "extraction_patterns": {
      "castling": {
        "pattern": "^(?:O-O-O|O-O)$",
        "order": 1
      },
      "promotion": {
        "pattern": "(?:=|\\/)([NBRQK])$",
        "order": 3
      },
      "check_or_mate": {
        "pattern": "([+#])$",
        "order": 2
      },
      "destination_square": {
        "pattern": "([a-h][1-8])$",
        "order": 4
      },
      "piece_type": {
        "pattern": "^([NBRQK])",
        "order": 5
      },
      "capture_indicator": {
        "pattern": "x",
        "order": 6
      }
    }
  }
}
