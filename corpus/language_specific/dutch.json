{
  "language": "Dutch",
  "iso_code": "nl",

  "header_section": {
    "fields": {
      "white_player": {
        "keywords": ["Wit", "wit", "Wit:", "W:", "White"],
        "pattern": ".+"
      },
      "black_player": {
        "keywords": ["Black", "Zwart", "zwart", "B:", "Z:"],
        "pattern": ".+"
      },
      "tournament": {
        "keywords": ["Toernooi", "toernooi", "tornooi", "Tornooi", "Evenement", "Event", "Tournament"],
        "pattern": ".+"
      },
      "date": {
        "keywords": ["Datum", "datum", "Date", "date"],
        "pattern": "^(?:(?:31(\\/|-|\\.)(?:0?[13578]|1[02]|(?:Jan|Mar|May|Jul|Aug|Oct|Dec))\\1(?:(?:1[6-9]|[2-9]\\d)?\\d{2}))|(?:(?:29|30)(\\/|-|\\.)(?:0?[1,3-9]|1[0-2]|(?:Jan|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec))\\2(?:(?:1[6-9]|[2-9]\\d)?\\d{2}))|(?:29(\\/|-|\\.)(?:0?2|(?:Feb))\\3(?:(?:(?:1[6-9]|[2-9]\\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))|(?:(?:0?[1-9]|1\\d|2[0-8])(\\/|-|\\.)(?:(?:0?[1-9]|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep))|(?:1[0-2]|(?:Oct|Nov|Dec)))\\4(?:(?:1[6-9]|[2-9]\\d)?\\d{2}))|(?:(?:(?:1[6-9]|[2-9]\\d)?\\d{2})(?:(?:(\\/|-|\\.)(?:0?[13578]|1[02])\\5(?:31))|(?:(\\/|-|\\.)(?:0?[13-9]|1[0-2])\\6(?:29|30))))|(?:(?:(?:(?:1[6-9]|[2-9]\\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00)))(\\/|-|\\.)0?2\\7(?:29))|(?:(?:(?:1[6-9]|[2-9]\\d)?\\d{2})(\\/|-|\\.)(?:(?:0?[1-9])|(?:1[0-2]))\\8(?:0?[1-9]|1\\d|2[0-8])))$"
      },
      "rating": {
        "keywords": ["Elo", "elo", "Rating", "rating"],
        "pattern": "^(?:0|[1-9]\\d{0,2}|[12]\\d{3}|3000)?$"
      },
      "result": {
        "keywords": ["Resultaat", "Uitslag", "uitslag", "resultaat"],
        "valid_values": ["1-0", "0-1", "½-½", "1/2-1/2", "0.5-0.5", "*", "remise"]
      }
    }
  },

  "grid_section": {
    "pieces": {
      "K": "Koning",
      "D": "Dame",
      "T": "Toren",
      "L": "Loper",
      "P": "Paard"
    },

    "valid_characters": {
      "letters": ["K", "D", "T", "L", "P", "a", "b", "c", "d", "e", "f", "g", "h"],
      "numbers": ["1", "2", "3", "4", "5", "6", "7", "8"],
      "symbols": ["x", "+", "#", "=", "-", "O"]
    },

   "cleaning_rules": [
     {
        "pattern": "\\b[oO0]-[oO0]-[oO0]\\b",
        "replacement": "O-O-O"
      },
      {
        "pattern": "\\b[oO0]-[oO0]\\b",
        "replacement": "O-O"
      },
      {
        "pattern": ":",
        "replacement": "x"
      },
      {
        "pattern": "\\b[Il](?=[a-h])",
        "replacement": "1"
      },
      {
        "pattern": "\\s+",
        "replacement": ""
      }
    ],

    "extraction_patterns": {
      "castling": {
        "pattern": "^(?:O-O-O|O-O)$",
        "order": 1
      },
      "promotion": {
        "pattern": "(?:=|\\/)([KDTLP])$",
        "order": 2
      },
      "check_or_mate": {
        "pattern": "([+#])$",
        "order": 3
      },
      "destination_square": {
        "pattern": "([a-h][1-8])$",
        "order": 4
      },
      "piece_type": {
        "pattern": "^([KDTLP])",
        "order": 5
      },
      "capture_indicator": {
        "pattern": "x",
        "order": 6
      }
    }
  }
}
